<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Dotted border -->
    <stroke
        android:color="#704FE6"
        android:width="2dp"
        android:dashWidth="6dp"
        android:dashGap="4dp"/>

    <!-- Background color -->
    <solid android:color="#F4F5F8"/>

    <!-- Rounded corners -->
    <corners android:radius="5dp"/>

    <!-- Padding for inner content -->
    <padding
        android:left="8dp"
        android:right="8dp"
        android:top="8dp"
        android:bottom="8dp"/>
</shape>
