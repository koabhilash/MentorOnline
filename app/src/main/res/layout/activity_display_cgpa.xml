<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white"
    tools:context=".CGPDisplayAActivity">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:layout_gravity="start"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CGPA"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_marginBottom="10dp"/>

    <!-- Illustration Image -->
    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/cgpa"
        android:layout_gravity="center"
        android:contentDescription="CGPA Image"
        android:scaleType="fitCenter"
        android:layout_marginBottom="10dp"/>

    <!-- CGPA Display -->
    <TextView
        android:id="@+id/tvCgpa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_button"
        android:text="CGPA: --"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginBottom="5dp"/>

    <!-- Student Name -->
    <TextView
        android:id="@+id/tvStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_background"
        android:text="Full Name"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginBottom="5dp"/>

    <!-- Registration Number -->
    <TextView
        android:id="@+id/tvRegNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:background="@drawable/border_background"
        android:text="Reg No"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginBottom="5dp"/>

    <!-- As of Date -->
    <TextView
        android:id="@+id/tvAsOfDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_background"
        android:text="As of Date"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginBottom="15dp"/>

    <!--
    <Button
        android:id="@+id/btnCalculateCgpa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_button"
        android:text="Calculate CGPA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:paddingHorizontal="20dp"
        android:drawablePadding="12dp"
        android:fontFamily="sans-serif-medium"/>
    -->

</LinearLayout>
