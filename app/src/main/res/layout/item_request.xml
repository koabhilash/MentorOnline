<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Student Name & Reg Number (Now Outside the Dotted Border) -->
    <TextView
        android:id="@+id/tvStudentNameReg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/green_rounded_bg"
        android:padding="8dp"
        android:text="A.Karthik(192211XXX)"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Request Container (Dotted Border) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@drawable/dotted_border"
        android:orientation="vertical">

        <!-- Reason -->
        <TextView
            android:id="@+id/tvSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Irregular To College"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Tagging ID -->
        <TextView
            android:id="@+id/tvTaggedPersonName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tagged Person: SSEXXX"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Date & View Button Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp">

            <!-- Date -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/rounded_bg"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="@android:color/black"/>

                <TextView
                    android:id="@+id/tvStartDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01/05/25"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <!-- View Button -->
            <Button
                android:id="@+id/btnView"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:backgroundTint="#0CD444"
                android:text="View"
                android:textColor="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
